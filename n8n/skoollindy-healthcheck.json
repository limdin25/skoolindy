          ]
        }
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "GET Runtime Config",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 280],
      "notesInFlow": true,
      "notes": "Returns masterEnabled, enabledProfiles, communitiesByProfile, keywordRules."
    },
    {
      "parameters": {
        "jsCode": "const health = $('GET Health').first().json;\nconst config = $input.first().json;\nconst ok = health && health.masterEnabled !== undefined && health.orchestrationMode !== undefined;\nconst profilesOk = Array.isArray(config.enabledProfiles) && config.enabledProfiles.length > 0;\nreturn [{\n  json: {\n    success: ok && profilesOk,\n    masterEnabled: health.masterEnabled,\n    orchestrationMode: health.orchestrationMode,\n    queueCount: health.queueCount,\n    enabledProfilesCount: health.enabledProfilesCount,\n    profilesOk,\n    timestamp: health.timestamp\n  }\n}];"
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
