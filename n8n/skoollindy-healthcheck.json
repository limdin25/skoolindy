      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "GET Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 280],
      "notesInFlow": true,
      "notes": "Requires SKOOLLINDY_BASE_URL and SKOOLLINDY_N8N_KEY."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SKOOLLINDY_BASE_URL || 'http://localhost:3113' }}/api/n8n/runtime-config",
        "options": { "timeout": 10000 },
        "sendHeaders": true,
        "headerParameters": {
